# ─────────────────────────────────────────────────────────────
# GetLeads environment. Everything below has a FREE tier.
# Only DATABASE_URL and JWT_SECRET are strictly required.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:5173            # dashboard URL (CORS + links in emails)
API_URL=http://localhost:8080            # public API URL (tracking pixels, webhooks)
# The two values below are EXAMPLES and are public (they are in this file). They work for local
# development only: with NODE_ENV=production the server refuses to start on either of them,
# and on any JWT_SECRET / ENCRYPTION_KEY shorter than 16 characters.
# For anything real, generate each one:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-32-bytes-base64-or-hex # encrypts stored SMTP creds / CRM tokens
# JWT_SECRET: at least 32 random characters in production (openssl rand -hex 32).
# Rotating ENCRYPTION_KEY: put the new value above and the previous one(s) here, comma-separated,
# newest first. Without this, credentials saved under the old key become unreadable.
ENCRYPTION_KEYS_OLD=

# ── Operator credentials ──
# Leave these empty rather than inventing a short one. In production a value that is a
# well-known placeholder ("changeme", "password", an example from the docs) is treated as not
# set: the door it guards stays shut and the log says why.
# Job runner (/internal/jobs/run, serverless deployments only). Header x-internal-token; never in a URL.
INTERNAL_TOKEN=
# Server-to-server admin API (/v1/admin/*), header x-admin-token. Unset = header access off.
ADMIN_API_TOKEN=
# Admin dashboard login (/admin). Use a long random password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: sign the admin session with its own secret (falls back to JWT_SECRET).
ADMIN_JWT_SECRET=
# Optional, recommended: a second factor on the admin login. A base32 secret (A-Z, 2-7) that
# you also add to an authenticator app as a time-based account ("Enter a setup key"). When
# set, /admin asks for the 6-digit code after the password. Unset = password only.
# Create one with:  openssl rand 20 | base32      (steps in DEPLOY.md section B9)
ADMIN_TOTP_SECRET=

# ── Network ──
# Which proxy header holds the visitor's address: cloudflare (Render, or a Cloudflare-proxied
# domain) | xff (Vercel, Fly, other reverse proxies) | none (no proxy).
# Unset: cloudflare on Render and in development, xff on any other production host.
TRUSTED_PROXY=
# Extra browser origins allowed to call the API (comma-separated). APP_URL is always allowed.
CORS_EXTRA_ORIGINS=
# Pattern of further allowed origins, matched against the WHOLE origin (write it as ^https://...$).
# "none" (or an empty value) allows only the exact origins above. Remove the line entirely
# to allow any https://*.vercel.app (Vercel preview deployments).
CORS_ALLOW_REGEX=none

# Database: Neon (0.5GB free, recommended - compute suspends on idle but never loses data,
# so a low-traffic pilot never breaks) or Supabase (500MB free, but the whole project - including
# auth/PostgREST - pauses after 7 days idle and needs a manual click to restore) or local docker
# The default matches `docker compose up -d db` (docker-compose.yml).
DATABASE_URL=postgres://prospex:prospex@localhost:5432/prospex
# How the database connection is encrypted. Leave unset and the server decides from the host:
#   - localhost / 127.0.0.1 / ::1: no TLS (same machine);
#   - a single-label name ("db"), a private-network name (*.internal, *.flycast, *.local,
#     *.lan) or a private address: TLS when the server offers it;
#   - *.neon.tech: TLS, and the server's certificate is checked;
#   - any other remote host: TLS required (never a silent fallback to plaintext).
# `sslmode=` in DATABASE_URL is honoured (disable, require, verify-full). To override both:
#   DATABASE_SSL=disable | require | verify-full
# For a provider that signs its certificates with its own CA (Supabase, Amazon RDS), verify
# with DATABASE_SSL=verify-full plus that CA: PEM text (\n for line breaks) or a file path.
DATABASE_SSL=
DATABASE_SSL_CA=
# Optional: run migrations as a separate role that owns the schema, so the application role
# can be limited to reading and writing rows. Unset = DATABASE_URL.
# MIGRATION_DATABASE_URL=

# Worker mode: "inline" runs jobs inside API requests (serverless, e.g. Vercel);
# "worker" expects `npm run start:worker` running as a separate process (Render/Fly/Docker)
JOB_MODE=worker

# ── AI (pick any; first configured one is used, in this order) ──
# Groq: free, fast, Llama 3.x   https://console.groq.com
GROQ_API_KEY=
# Google Gemini: free tier      https://aistudio.google.com
GEMINI_API_KEY=
# Anthropic Claude (paid, best quality)
ANTHROPIC_API_KEY=
# Any OpenAI-compatible endpoint (Ollama, Together, OpenRouter free models...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
AI_PROVIDER=auto                          # auto | groq | gemini | anthropic | openai-compat

# ── Web search for lead discovery (pick any; all optional, DDG fallback needs no key) ──
# Google Programmable Search (recommended, genuinely free): 100 queries/day free
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# SerpAPI: 100 searches/month free
SERPER_API_KEY=
SERPAPI_KEY=
# Brave Search API: no free tier since Feb 2026 - $5 per 1,000 queries, $5/mo minimum credit
BRAVE_SEARCH_API_KEY=

# ── Data providers (optional; each has a free tier; used BEFORE web discovery when set) ──
# Apollo.io free plan: people search + enrich       https://developer.apollo.io
APOLLO_API_KEY=
# People Data Labs: 100 person enrich/month free    https://www.peopledatalabs.com
PDL_API_KEY=
# ipinfo.io: 50k IP lookups/month free (website visitor identification; ipapi.is keyless is default)
IPINFO_TOKEN=

# ── Email verification (built-in MX + SMTP handshake is free; these are optional boosts) ──
# Hunter.io: 25 searches + 50 verifications/month free
HUNTER_API_KEY=
# Abstract API email validation: 100/month free
ABSTRACT_EMAIL_API_KEY=
# SMTP probing needs outbound port 25. Most PaaS block it; set to false there.
SMTP_PROBE_ENABLED=true

# ── Outbound email (pick one) ──
# Resend: 3,000 emails/month free  https://resend.com
RESEND_API_KEY=
# Signing secret of the Resend webhook pointed at <API_URL>/v1/email-events/resend. Without it
# delivery events (bounces, spam complaints) are refused and never reach the suppression list.
RESEND_WEBHOOK_SECRET=
# Or any SMTP (Brevo 300/day free, Gmail app password, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="GetLeads <hello@yourdomain.com>"

# ── Billing (required for the production path; pilot runs fully free without Stripe) ──
# Set one STRIPE_PRICE_<PLAN> per plan id in packages/db/src/plans.ts you want purchasable
# (uppercased, e.g. plan "starter" -> STRIPE_PRICE_STARTER). Four real paid tiers - see
# docs/PRICING.md and DEPLOY.md section A7 for the exact Stripe product setup steps.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_ENTERPRISE=

# ── Pilot controls ──
# PILOT_MODE=true (this default): every signup gets the generous free "pilot" plan, billing off.
# PILOT_MODE=false (production path - see DEPLOY.md): signups land on the tight "free" plan and
# Stripe "Upgrade" buttons go live for the four paid tiers below once STRIPE_* vars are set.
PILOT_MODE=true
PILOT_INVITE_CODE=                        # if set, signup requires this code
DEFAULT_PLAN=pilot                        # free | pilot | starter | growth | scale | enterprise

# ── Web app (apps/web/.env) ──
VITE_API_URL=http://localhost:8080

# Sign in with Google (optional). Authorized redirect URI in the Google console must be
# exactly <API_URL>/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Outbound sending safety ──
# Platform-wide kill switch. Set to "false" to stop every campaign send immediately
# (contacts are held and resume when it is switched back on; nothing is lost).
OUTBOUND_SENDING_ENABLED=true
# Most emails one workspace may send per day across ALL of its senders (default 2000).
# A single workspace can be given its own number with planLimits.emailsPerDay.
# ORG_DAILY_SEND_CEILING=2000
# Daily cap per workspace on the shared platform sender. Default: 50, or 1/20 of the
# plan's monthly emails, whichever is larger.
# SYSTEM_SENDER_DAILY_CAP=50
# Extra SMTP ports customers may use, beyond 25, 26, 465, 587, 2465, 2525, 2587.
# SMTP_ALLOWED_PORTS=

# ── Process ──
# On a restart (SIGTERM) the server stops taking connections and lets requests and jobs in
# progress finish for up to this long, then hands unfinished jobs back to the queue.
# SHUTDOWN_GRACE_MS=25000
# HTTP server timeouts. keep-alive must be longer than the idle timeout of the proxy in front.
# HTTP_KEEPALIVE_TIMEOUT_MS=75000
# HTTP_REQUEST_TIMEOUT_MS=120000
# HTTP_HEADERS_TIMEOUT_MS=30000

# ── Rollback-friendly switches (DEPLOY.md B11). Defaults keep a rollback to the previous
#    release cheap; leave them commented out unless you want the other behaviour. ──
# "true": rewrite old-format saved credentials in the new workspace-bound format when they
# are read (the previous release cannot read that format). Default: off.
# CREDENTIAL_REBIND_ON_READ=true
# "true": after giving existing client report links a hash and an encrypted copy, also remove
# the readable copy (the previous release finds links by it). Default: off.
# LINK_TOKENS_CLEAR_PLAINTEXT=true
# "off": the daily clean-up skips removing the content of messages and activity of leads that
# were deleted before this release. Default: on. It deletes, so it cannot be rolled back.
# PRIVACY_SWEEP=off
# "true": allow the old visitor look-up provider that only answers over plain HTTP, as the
# last one tried. Default: off (HTTPS providers only; set IPINFO_TOKEN above for capacity).
# IP_LOOKUP_ALLOW_PLAIN_HTTP=true
