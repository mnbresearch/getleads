# The workspace packages are named @prospex/* but the @prospex scope on the public npm
# registry does not belong to this project. Inside the repository they resolve locally
# (npm workspaces), so nothing is ever fetched for them. If an install is ever run somewhere
# the workspace root is missing (one app directory on its own, a broken lockfile), npm would
# otherwise ask the public registry for "@prospex/core" and install whatever a stranger had
# published under that name. Pointing the scope at a registry that does not exist makes that
# install fail instead.
@prospex:registry=https://registry.invalid/
