VITE_API_URL=http://localhost:8080

# YouTube id of the explainer on the landing page - the part after v= in the watch URL.
# Leave it unset and the video section does not render at all, which is deliberate: a
# landing page with a broken player is worse than one with no player.
# The poster shown before the visitor presses play is public/demo-poster.jpg, served from
# this site so that nothing is requested from YouTube until then. When this id changes,
# replace that file with the new video's poster frame (1280x720 JPEG).
VITE_DEMO_VIDEO_ID=
