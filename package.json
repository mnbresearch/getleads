{
  "name": "prospex",
  "private": true,
  "version": "0.1.0",
  "description": "Prospex - open, zero-cost B2B lead generation infrastructure for sales teams and AI agents",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/core -w packages/db -w packages/sdk -w packages/mcp -w apps/api -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run worker -w apps/api",
    "db:migrate": "npm run migrate -w packages/db",
    "db:seed": "npm run seed -w packages/db",
    "start:api": "npm run start -w apps/api",
    "start:worker": "npm run worker:prod -w apps/api"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
