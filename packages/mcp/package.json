{
  "name": "@getleads/mcp",
  "version": "0.1.0",
  "description": "MCP server exposing GetLeads to AI agents (Claude Desktop, Claude Code, Cursor, Cortex...)",
  "type": "module",
  "bin": { "getleads-mcp": "./dist/server.js" },
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "@getleads/sdk": "*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "license": "MIT"
}
